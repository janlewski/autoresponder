# Allegro OAuth2 credentials
ALLEGRO_CLIENT_ID=your_client_id
ALLEGRO_CLIENT_SECRET=your_client_secret
# Optional legacy bootstrap token. Prefer connecting through the dashboard; refreshed
# tokens are stored durably in SQLite.
ALLEGRO_REFRESH_TOKEN=
# production | sandbox
ALLEGRO_ENV=production
ALLEGRO_REDIRECT_URI=
PROCESS_ISSUES=true
PROCESS_ORDERS=true

# Polling config
POLL_INTERVAL=60
MAX_THREADS=5
MAX_ISSUES=5


# Reply rules
REPLY_ONLY_FIRST=true


# Templates
TEMPLATE_FIRST_CONTACT=
TEMPLATE_ISSUE=
TEMPLATE_ORDER=
